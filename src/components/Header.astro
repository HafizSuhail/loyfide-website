---
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <Logo alt="LOYFIDE™ home" />
    </a>
  </div>
</header>

<style lang="scss">
  @use '../styles/abstracts/mixins' as *;

  .site-header {
    &__inner {
      @include container;

      display: flex;
      align-items: center;
      padding-block: var(--space-4);
    }

    // Sizes the Logo inside it (a parent's scoped styles can't reach a child component's elements)
    &__brand {
      display: block;
      width: 6rem;
      padding-block: var(--space-1); // keeps the tap target ≥ 44px tall
      border-radius: var(--radius-sm);
    }
  }
</style>
