---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout
  title="LOYFIDE™ | Launching soon on Amazon India"
  description="LOYFIDE™ is thoughtfully made and launching soon on Amazon India. Follow @loyfide on Instagram for updates."
  showHeader={false}
>
  <section class="coming-soon" aria-labelledby="coming-soon-title">
    <div class="coming-soon__inner">
      <h1 id="coming-soon-title" class="coming-soon__brand">
        <Logo priority />
      </h1>

      <span class="coming-soon__rule" aria-hidden="true"></span>

      <p class="coming-soon__tagline">
        <span class="coming-soon__tagline-line">Thoughtfully made.</span>
        <span class="coming-soon__tagline-line">Launching soon on Amazon&nbsp;India.</span>
      </p>

      <ul class="coming-soon__links" role="list">
        <li>
          <Button href="https://instagram.com/loyfide" variant="primary">
            Follow @loyfide on Instagram
          </Button>
        </li>
        <li>
          <Button href="mailto:support@loyfide.com" variant="secondary">
            support@loyfide.com
          </Button>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/abstracts/mixins' as *;
  @use '../styles/abstracts/breakpoints' as *;

  .coming-soon {
    display: grid;
    flex: 1;
    place-items: center;
    // Height-aware spacing so short screens (landscape phones, small laptops) still fit
    padding-block: clamp(var(--space-6), 8svh, var(--space-10));
    animation: coming-soon-in var(--duration-slow) var(--ease-out) both;
    // Rose base everywhere + glows sized explicitly (not from the box's aspect ratio),
    // so a tall phone screen gets the same coverage as a wide laptop screen.
    background:
      radial-gradient(150% 55% at 50% 0%, var(--color-surface-tint-strong), transparent),
      radial-gradient(150% 40% at 50% 100%, var(--color-surface-tint-strong), transparent),
      var(--color-surface-tint);

    &__inner {
      @include container(40rem);

      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    // Logo (cropped artwork, ~2.5:1) is also capped by viewport height for short screens
    &__brand {
      width: min(100%, 15rem, 55svh);

      @include mq('md') {
        width: min(100%, 18rem, 55svh);
      }

      @include mq('xl') {
        width: min(100%, 21rem, 50svh);
      }
    }

    &__rule {
      display: block;
      width: var(--space-8);
      height: var(--border-width);
      margin-block: var(--space-6);
      background-color: var(--color-accent-strong);
    }

    &__tagline {
      font-family: var(--font-heading);
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-regular);
      line-height: var(--line-height-tight);
      color: var(--color-text);
    }

    &__tagline-line {
      display: block;
    }

    &__links {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      width: 100%;
      margin-top: var(--space-7);
      padding: 0;

      @include mq('sm') {
        flex-flow: row wrap;
        justify-content: center;
      }

      :global(.button) {
        width: 100%;
      }
    }
  }

  @keyframes coming-soon-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
