---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="LOYFIDE™ | Launching soon on Amazon India"
  description="LOYFIDE™ is thoughtfully made and launching soon on Amazon India. Follow @loyfide on Instagram for updates."
  showHeader={false}
>
  <section class="coming-soon" aria-labelledby="coming-soon-title">
    <div class="coming-soon__inner">
      <h1 id="coming-soon-title" class="coming-soon__brand">
        <img
          class="coming-soon__logo"
          src="/brand/loyfide-logo.jpg"
          alt="LOYFIDE™"
          width="1662"
          height="884"
          fetchpriority="high"
        />
        <span class="coming-soon__tm" aria-hidden="true">™</span>
      </h1>

      <span class="coming-soon__rule" aria-hidden="true"></span>

      <p class="coming-soon__tagline">
        <span class="coming-soon__tagline-line">Thoughtfully made.</span>
        <span class="coming-soon__tagline-line">Launching soon on Amazon&nbsp;India.</span>
      </p>

      <ul class="coming-soon__links" role="list">
        <li>
          <Button href="https://instagram.com/loyfide" variant="primary">
            Follow @loyfide on Instagram
          </Button>
        </li>
        <li>
          <Button href="mailto:support@loyfide.com" variant="secondary">
            support@loyfide.com
          </Button>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/abstracts/mixins' as *;
  @use '../styles/abstracts/breakpoints' as *;

  .coming-soon {
    display: grid;
    flex: 1;
    place-items: center;
    // Height-aware spacing so short screens (landscape phones, small laptops) still fit
    padding-block: clamp(var(--space-6), 8svh, var(--space-10));
    // Opacity-only fade on the element that owns the background, so the logo's
    // multiply blend (below) still reaches the background through the animation's isolation group.
    animation: coming-soon-in var(--duration-slow) var(--ease-out) both;
    background:
      radial-gradient(ellipse at 50% 0%, var(--color-rose-200), transparent 60%),
      radial-gradient(ellipse at 50% 100%, var(--color-rose-100), transparent 55%),
      var(--color-bg);

    &__inner {
      @include container(40rem);

      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    // Logo width is capped by viewport height too (logo is ~1.88:1)
    &__brand {
      position: relative;
      width: min(100%, 22rem, 75svh);
      container-type: inline-size;
      // Supplied logo is a JPEG on white; multiply drops the white box on the tinted background.
      // Set here, not on the img: container-type isolates its children from the backdrop.
      mix-blend-mode: multiply;

      @include mq('md') {
        width: min(100%, 28rem, 75svh);
      }

      @include mq('xl') {
        width: min(100%, 34rem, 60svh);
      }
    }

    // The logo file has ~24% empty white below the wordmark (rows 674–884 of 884).
    // Hide it in CSS (file untouched) so the gap above the divider matches the gap below.
    &__logo {
      width: 100%;
      aspect-ratio: 1662 / 674;
      object-fit: cover;
      object-position: top;
    }

    // Positioned against the wordmark's top-right corner (measured from the logo file:
    // right edge 80.75% of width, cap top at row 531 of the 674 visible rows = 78.8%),
    // sized in container units so it scales with the logo.
    &__tm {
      position: absolute;
      top: 78.8%;
      left: 81.4%;
      font-family: var(--font-body);
      font-size: 3.6cqi;
      font-weight: var(--font-weight-medium);
      line-height: 1;
      transform: translateY(-0.18em);
    }

    &__rule {
      display: block;
      width: var(--space-8);
      height: var(--border-width);
      margin-block: var(--space-6);
      background-color: var(--color-accent-strong);
    }

    &__tagline {
      font-family: var(--font-heading);
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-regular);
      line-height: var(--line-height-tight);
      color: var(--color-text);
    }

    &__tagline-line {
      display: block;
    }

    &__links {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      width: 100%;
      margin-top: var(--space-7);
      padding: 0;

      @include mq('sm') {
        flex-flow: row wrap;
        justify-content: center;
      }

      :global(.button) {
        width: 100%;
      }
    }
  }

  @keyframes coming-soon-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
