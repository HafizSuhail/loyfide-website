---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Page not found | LOYFIDE™"
  description="The page you are looking for could not be found."
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__inner">
      <p class="not-found__code">404</p>
      <h1 id="not-found-title" class="not-found__title">Page not found</h1>
      <p class="not-found__text">The page you are looking for doesn’t exist or has moved.</p>
      <Button href="/" variant="primary">Back to home</Button>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/abstracts/mixins' as *;

  .not-found {
    display: grid;
    flex: 1;
    place-items: center;
    padding-block: clamp(var(--space-6), 8svh, var(--space-10));

    &__inner {
      @include container(40rem);

      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
      text-align: center;
    }

    &__code {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      letter-spacing: var(--letter-spacing-wide);
    }

    &__text {
      margin-bottom: var(--space-4);
      color: var(--color-text-muted);
    }
  }
</style>
